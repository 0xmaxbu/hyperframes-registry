{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-bar-escort",
  "type": "hyperframes:block",
  "title": "Bar Escort — accent bar delivers the headline lines",
  "description": "Content block: an accent bar sweeps in from the left, then each headline line slides out from behind it, staggered — the bar escorts the text into place. *word* markers tint with the bar color. One-shot, holds.",
  "tags": [
    "text",
    "typography",
    "cjk",
    "bar",
    "headline",
    "landscape"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 60,
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Lines separated by \\n; *word* = emphasized (accent color)",
      "default": "新能源革命\\n2026 *关键拐点*",
      "maxLength": 300
    },
    {
      "id": "interval",
      "type": "number",
      "role": "style",
      "label": "Interval",
      "description": "Stagger between lines in seconds (0.1-0.8)",
      "default": 0.28,
      "min": 0.1,
      "max": 0.8,
      "step": 0.02
    },
    {
      "id": "duration",
      "type": "number",
      "role": "style",
      "label": "Duration",
      "description": "Line slide seconds (0.3-1.2)",
      "default": 0.6,
      "min": 0.3,
      "max": 1.2,
      "step": 0.05
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Font size in px (28-160)",
      "default": 72,
      "min": 28,
      "max": 160,
      "step": 2
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Ink",
      "description": "Text color",
      "default": "#f1f5f9"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "description": "Escort bar + emphasized word color",
      "default": "#f97316"
    },
    {
      "id": "intro",
      "type": "number",
      "role": "style",
      "label": "Delay",
      "description": "Seconds before the bar sweeps in (0-2)",
      "default": 0.2,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  ],
  "files": [
    {
      "path": "text-bar-escort.html",
      "target": "compositions/text-bar-escort.html",
      "type": "hyperframes:composition"
    }
  ]
}
