{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-word-echo",
  "type": "hyperframes:block",
  "title": "Word Echo — stacked repeats of one word",
  "description": "Content block: one word repeated as a diagonal stack of dimming echoes that drop in one by one, then the accent-colored main word slams on top — a data-story emphasis beat. One-shot.",
  "tags": [
    "text",
    "typography",
    "cjk",
    "echo",
    "emphasis",
    "landscape"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 60,
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Word",
      "description": "The word/phrase to stack (no line breaks)",
      "default": "护城河",
      "maxLength": 60
    },
    {
      "id": "echoes",
      "type": "number",
      "role": "style",
      "label": "Echoes",
      "description": "Echo copies behind the main word (2-8)",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1
    },
    {
      "id": "spread",
      "type": "number",
      "role": "style",
      "label": "Spread",
      "description": "Diagonal offset between copies in px (8-60)",
      "default": 22,
      "min": 8,
      "max": 60,
      "step": 2
    },
    {
      "id": "interval",
      "type": "number",
      "role": "style",
      "label": "Interval",
      "description": "Stagger between copies in seconds (0.05-0.4)",
      "default": 0.12,
      "min": 0.05,
      "max": 0.4,
      "step": 0.01
    },
    {
      "id": "duration",
      "type": "number",
      "role": "style",
      "label": "Duration",
      "description": "Each copy entrance seconds (0.3-1)",
      "default": 0.45,
      "min": 0.3,
      "max": 1,
      "step": 0.05
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Font size in px (40-260)",
      "default": 140,
      "min": 40,
      "max": 260,
      "step": 2
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Ink",
      "description": "Echo copies color",
      "default": "#38bdf8"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "description": "Main (front) word color",
      "default": "#fbbf24"
    },
    {
      "id": "intro",
      "type": "number",
      "role": "style",
      "label": "Delay",
      "description": "Seconds before the first echo drops (0-2)",
      "default": 0.2,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  ],
  "files": [
    {
      "path": "text-word-echo.html",
      "target": "compositions/text-word-echo.html",
      "type": "hyperframes:composition"
    }
  ]
}
