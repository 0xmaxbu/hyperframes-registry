{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-flip-3d",
  "type": "hyperframes:block",
  "title": "Flip 3D — card-flip word entrance",
  "description": "Content block: CJK-segmented words flip in like cards — rotateY/rotateX 90° to 0 with perspective, staggered; optional alternating direction. *word* markers tint with the accent color. One-shot, holds.",
  "tags": [
    "text",
    "typography",
    "cjk",
    "flip",
    "3d",
    "reveal",
    "landscape"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 60,
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Text; \\n = line break; *word* = emphasized (accent color)",
      "default": "新品 *全球首发*",
      "maxLength": 400
    },
    {
      "id": "unit",
      "type": "enum",
      "role": "style",
      "label": "Unit",
      "description": "Flip unit: CJK word or character",
      "default": "word",
      "options": [
        {
          "value": "word",
          "label": "Word (CJK-segmented)"
        },
        {
          "value": "char",
          "label": "Character"
        }
      ]
    },
    {
      "id": "axis",
      "type": "enum",
      "role": "style",
      "label": "Axis",
      "description": "Flip axis",
      "default": "y",
      "options": [
        {
          "value": "y",
          "label": "Vertical card flip (rotateY)"
        },
        {
          "value": "x",
          "label": "Horizontal tile flip (rotateX)"
        }
      ]
    },
    {
      "id": "alternate",
      "type": "enum",
      "role": "style",
      "label": "Alternate",
      "description": "Alternate flip direction between units",
      "default": "off",
      "options": [
        {
          "value": "off",
          "label": "Same direction"
        },
        {
          "value": "on",
          "label": "Alternating"
        }
      ]
    },
    {
      "id": "interval",
      "type": "number",
      "role": "style",
      "label": "Interval",
      "description": "Stagger between units in seconds (0.03-0.4)",
      "default": 0.1,
      "min": 0.03,
      "max": 0.4,
      "step": 0.01
    },
    {
      "id": "duration",
      "type": "number",
      "role": "style",
      "label": "Duration",
      "description": "Unit flip seconds (0.35-1.2)",
      "default": 0.6,
      "min": 0.35,
      "max": 1.2,
      "step": 0.05
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Font size in px (24-180)",
      "default": 92,
      "min": 24,
      "max": 180,
      "step": 2
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Ink",
      "description": "Text color",
      "default": "#f1f5f9"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "description": "Emphasized (*marked*) unit color",
      "default": "#34d399"
    },
    {
      "id": "intro",
      "type": "number",
      "role": "style",
      "label": "Delay",
      "description": "Seconds before the first unit flips (0-2)",
      "default": 0.2,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  ],
  "files": [
    {
      "path": "text-flip-3d.html",
      "target": "compositions/text-flip-3d.html",
      "type": "hyperframes:composition"
    }
  ]
}
