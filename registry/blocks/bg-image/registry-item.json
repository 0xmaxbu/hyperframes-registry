{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "bg-image",
  "type": "hyperframes:block",
  "title": "Image Background — ken-burns full-bleed photo",
  "description": "One-shot photo background: cover-cropped image with a seek-safe ken-burns move (9 presets) that spans scene_dur, scrim for text readability. Non-looping; cut anywhere at or after scene_dur. Landscape 16:9 twin of bg-image-portrait (same source, re-laid out for aspect).",
  "tags": ["background", "image", "ken-burns", "photo", "one-shot", "landscape"],
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 60,
  "variables": [
    { "id": "src", "type": "image", "role": "content", "label": "Image", "description": "Full-bleed cover image (URL or project asset path)", "default": "assets/bg-image-placeholder.svg" },
    { "id": "move", "type": "enum", "role": "style", "label": "Camera move", "description": "Ken-burns move over scene_dur", "default": "push-in", "options": [{"value":"push-in","label":"Push in"},{"value":"zoom-in","label":"Zoom in"},{"value":"pull-out","label":"Pull out"},{"value":"zoom-out","label":"Zoom out"},{"value":"pan-left","label":"Pan left"},{"value":"pan-right","label":"Pan right"},{"value":"pan-up","label":"Pan up"},{"value":"pan-down","label":"Pan down"},{"value":"none","label":"None"}] },
    { "id": "max_zoom", "type": "number", "role": "style", "label": "Max zoom", "description": "Ken-burns zoom base (1-2); pans auto-raise up to 2.0 to keep minimum travel", "default": 1.15, "min": 1, "max": 2, "step": 0.05 },
    { "id": "focus_x", "type": "number", "role": "style", "label": "Focus X", "description": "Transform origin X 0-1", "default": 0.5, "min": 0, "max": 1, "step": 0.05 },
    { "id": "focus_y", "type": "number", "role": "style", "label": "Focus Y", "description": "Transform origin Y 0-1", "default": 0.5, "min": 0, "max": 1, "step": 0.05 },
    { "id": "scrim", "type": "number", "role": "style", "label": "Scrim", "description": "Black overlay strength for text readability 0-1", "default": 0.35, "min": 0, "max": 1, "step": 0.05 },
    { "id": "dim", "type": "number", "role": "style", "label": "Dim", "description": "De-bright / de-saturate 0-1", "default": 0, "min": 0, "max": 1, "step": 0.05 },
    { "id": "bg", "type": "color", "role": "style", "label": "Background", "description": "Base color shown before intro", "default": "#000000" },
    { "id": "intro", "type": "number", "role": "style", "label": "Intro", "description": "Fade-in seconds", "default": 0.6, "min": 0, "max": 3, "step": 0.1 },
    { "id": "scene_dur", "type": "number", "role": "style", "label": "Scene duration", "description": "Plan to cut around this length; the move spans it (5-60)", "default": 15, "min": 5, "max": 60, "step": 1 }
  ],
  "files": [
    { "path": "bg-image.html", "target": "compositions/bg-image.html", "type": "hyperframes:composition" },
    { "path": "assets/bg-image-placeholder.svg", "target": "assets/bg-image-placeholder.svg", "type": "hyperframes:asset" }
  ]
}
