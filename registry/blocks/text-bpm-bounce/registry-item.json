{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-bpm-bounce",
  "type": "hyperframes:block",
  "title": "BPM Bounce — beat-synced word hop (loop)",
  "description": "Content block (seamless loop): words hop one per beat at a set BPM — the bouncing word scales, lifts and flashes the accent color while the rest rest in ink. Loop = word count × 60/BPM, cut anywhere. Cut to music beds for data-story rhythm.",
  "tags": [
    "text",
    "typography",
    "cjk",
    "beat",
    "bounce",
    "loop",
    "landscape"
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 60,
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Words",
      "description": "Words separated by spaces or \\n; each word bounces on its own beat (default text = 5 words, loop 2.5s at 120 BPM)",
      "default": "降 本 增 效 提 质",
      "maxLength": 200
    },
    {
      "id": "bpm",
      "type": "number",
      "role": "style",
      "label": "BPM",
      "description": "Beats per minute (60-180); loop = word count × 60/bpm",
      "default": 120,
      "min": 60,
      "max": 180,
      "step": 1
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Font size in px (28-160)",
      "default": 100,
      "min": 28,
      "max": 160,
      "step": 2
    },
    {
      "id": "hop",
      "type": "number",
      "role": "style",
      "label": "Hop",
      "description": "Bounce strength 0-1 (scale + hop height)",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Ink",
      "description": "Resting word color",
      "default": "#94a3b8"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "description": "Bouncing word color",
      "default": "#f97316"
    },
    {
      "id": "intro",
      "type": "number",
      "role": "style",
      "label": "Delay",
      "description": "Fade-in seconds before bouncing starts (0-2)",
      "default": 0.4,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  ],
  "files": [
    {
      "path": "text-bpm-bounce.html",
      "target": "compositions/text-bpm-bounce.html",
      "type": "hyperframes:composition"
    }
  ]
}
