{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-fold-swap-portrait",
  "type": "hyperframes:block",
  "title": "Fold Swap — tracking-collapse phrase exchange (portrait 9:16)",
  "description": "Content block: phrase A appears, holds, then folds — letter-spacing collapses into a dense block as it fades — and phrase B unfolds from the same dense state to full tracking. A pivot-the-claim beat for data narratives. One-shot, holds on B.",
  "tags": [
    "text",
    "typography",
    "cjk",
    "fold",
    "swap",
    "portrait"
  ],
  "dimensions": {
    "width": 1080,
    "height": 1920
  },
  "duration": 60,
  "variables": [
    {
      "id": "text_a",
      "type": "string",
      "role": "content",
      "label": "Phrase A",
      "description": "Opening phrase; *word* = emphasized (accent color)",
      "default": "从 *流量* 思维",
      "maxLength": 120
    },
    {
      "id": "text_b",
      "type": "string",
      "role": "content",
      "label": "Phrase B",
      "description": "Closing phrase the swap lands on; *word* = emphasized",
      "default": "到 *留量* 思维",
      "maxLength": 120
    },
    {
      "id": "hold",
      "type": "number",
      "role": "style",
      "label": "Hold",
      "description": "Seconds phrase A stays before folding (0.5-5)",
      "default": 1.6,
      "min": 0.5,
      "max": 5,
      "step": 0.1
    },
    {
      "id": "fold_dur",
      "type": "number",
      "role": "style",
      "label": "Fold duration",
      "description": "Seconds of each fold/unfold (0.3-1.5)",
      "default": 0.7,
      "min": 0.3,
      "max": 1.5,
      "step": 0.05
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Font size in px (28-180)",
      "default": 92,
      "min": 28,
      "max": 180,
      "step": 2
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Ink",
      "description": "Text color",
      "default": "#f1f5f9"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "description": "Emphasized (*marked*) word color",
      "default": "#34d399"
    },
    {
      "id": "intro",
      "type": "number",
      "role": "style",
      "label": "Delay",
      "description": "Seconds before phrase A appears (0-2)",
      "default": 0.2,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  ],
  "files": [
    {
      "path": "text-fold-swap-portrait.html",
      "target": "compositions/text-fold-swap-portrait.html",
      "type": "hyperframes:composition"
    }
  ]
}
