{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "bg-data-stream",
  "type": "hyperframes:block",
  "title": "Data Stream Background — seamless hex data rain",
  "description": "Seamlessly looping data-stream background: dense hex/digit columns, movie-style trails (bright head, first 5 chars dim in sequence, constant after). Full-canvas, bottom track under text; scrim/dim keep copy readable. Landscape 16:9 twin of bg-data-stream-portrait (same source, re-laid out for aspect).",
  "tags": ["background", "data-stream", "code-rain", "tech", "loop", "seamless", "landscape"],
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 64,
  "variables": [
    { "id": "color", "type": "color", "role": "style", "label": "Stream color", "description": "Trail character color", "default": "#00ffcc" },
    { "id": "density", "type": "number", "role": "style", "label": "Density", "description": "Max column count (8-300)", "default": 200, "min": 8, "max": 300, "step": 4 },
    { "id": "speed", "type": "number", "role": "style", "label": "Speed", "description": "Fall speed feel (20-400)", "default": 100, "min": 20, "max": 400, "step": 10 },
    { "id": "charset", "type": "enum", "role": "style", "label": "Charset", "description": "hex / digits / binary / katakana / en / zh / ja (phrase rain)", "default": "hex", "options": [{"value":"hex","label":"Hex"},{"value":"digits","label":"Digits"},{"value":"binary","label":"Binary"},{"value":"katakana","label":"Katakana"},{"value":"en","label":"English phrases"},{"value":"zh","label":"Chinese phrases"},{"value":"ja","label":"Japanese phrases"}] },
    { "id": "intensity", "type": "number", "role": "style", "label": "Intensity", "description": "Trail brightness 0-1", "default": 0.82, "min": 0, "max": 1, "step": 0.05 },
    { "id": "direction", "type": "enum", "role": "style", "label": "Direction", "description": "Fall direction", "default": "down", "options": [{"value":"down","label":"Down"},{"value":"up","label":"Up"}] },
    { "id": "bg", "type": "color", "role": "style", "label": "Background", "description": "Canvas base color", "default": "#05060d" },
    { "id": "scrim", "type": "number", "role": "style", "label": "Scrim", "description": "Black overlay strength for text readability 0-1", "default": 0, "min": 0, "max": 1, "step": 0.05 },
    { "id": "dim", "type": "number", "role": "style", "label": "Dim", "description": "De-bright / de-saturate 0-1", "default": 0, "min": 0, "max": 1, "step": 0.05 },
    { "id": "intro", "type": "number", "role": "style", "label": "Intro", "description": "Fade-in seconds", "default": 0.6, "min": 0, "max": 3, "step": 0.1 }
  ],
  "files": [
    { "path": "bg-data-stream.html", "target": "compositions/bg-data-stream.html", "type": "hyperframes:composition" }
  ]
}
