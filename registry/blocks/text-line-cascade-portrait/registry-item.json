{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-line-cascade-portrait",
  "type": "hyperframes:block",
  "title": "Line Cascade — masked line-by-line waterfall (portrait 9:16)",
  "description": "Content block: whole lines revealed top-to-bottom, each sliding up inside its own mask window (classic editorial line reveal). *word* markers tint with the accent color. One-shot, holds.",
  "tags": [
    "text",
    "typography",
    "cjk",
    "line-reveal",
    "waterfall",
    "portrait"
  ],
  "dimensions": {
    "width": 1080,
    "height": 1920
  },
  "duration": 60,
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Lines",
      "description": "Lines separated by \\n, revealed top to bottom; *word* = emphasized (accent color)",
      "default": "三个信号同时出现\\n*拐点*得到确认\\n仓位管理是核心",
      "maxLength": 400
    },
    {
      "id": "interval",
      "type": "number",
      "role": "style",
      "label": "Interval",
      "description": "Stagger between lines in seconds (0.1-0.8)",
      "default": 0.3,
      "min": 0.1,
      "max": 0.8,
      "step": 0.02
    },
    {
      "id": "duration",
      "type": "number",
      "role": "style",
      "label": "Duration",
      "description": "Line reveal seconds (0.4-1.5)",
      "default": 0.7,
      "min": 0.4,
      "max": 1.5,
      "step": 0.05
    },
    {
      "id": "font_size",
      "type": "number",
      "role": "style",
      "label": "Font size",
      "description": "Font size in px (24-140)",
      "default": 68,
      "min": 24,
      "max": 140,
      "step": 2
    },
    {
      "id": "align",
      "type": "enum",
      "role": "style",
      "label": "Align",
      "description": "Line alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "id": "color",
      "type": "color",
      "role": "style",
      "label": "Ink",
      "description": "Text color",
      "default": "#f1f5f9"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "style",
      "label": "Accent",
      "description": "Emphasized (*marked*) word color",
      "default": "#f472b6"
    },
    {
      "id": "intro",
      "type": "number",
      "role": "style",
      "label": "Delay",
      "description": "Seconds before the first line reveals (0-2)",
      "default": 0.2,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  ],
  "files": [
    {
      "path": "text-line-cascade-portrait.html",
      "target": "compositions/text-line-cascade-portrait.html",
      "type": "hyperframes:composition"
    }
  ]
}
